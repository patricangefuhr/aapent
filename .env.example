# Kopier til .env og fyll ut. .env er gitignored — legg ALDRI ekte verdier i git.

# Supabase Postgres connection string (for import + nearby-test, backend/service-role).
# Finnes i Supabase: Project Settings -> Database -> Connection string (URI).
# SECRET.
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Frontend (settes senere, steg 5). anon key er OK i klient (beskyttet av RLS).
# SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# SUPABASE_ANON_KEY=<anon-key>
